# Bouquin: Convex deployment env vars (set on the deployment, not in this file)
#
#   npx convex env set REDDIT_CLIENT_ID     <14-char id under the app name at reddit.com/prefs/apps>
#   npx convex env set REDDIT_CLIENT_SECRET <the "secret" field of the same app>
#   npx convex env set REDDIT_USER_AGENT    "web:com.neorgon.bouquin:v1.0 (by /u/<your reddit username>)"
#
# scripts/setup-reddit.sh walks through creating the app and runs those
# three commands. Nothing in this repo reads a local .env at runtime: the
# cron runs on Convex and reads process.env there. The entries below exist
# so the shape is documented and so a local `.env` can be diffed against it.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:com.neorgon.bouquin:v1.0 (by /u/USERNAME)
